{
  "datasets": [
    {
      "name": "fa4710b8",
      "displayName": "Shoppulse Transaction Records Summary Dataset",
      "queryLines": [
        "\n",
        "SELECT user_id,\n",
        "       round(sum(chiffre_affaires), 2) AS ca_total,\n",
        "       sum(nb_commandes)               AS nb_commandes\n",
        "FROM shoppulse.dev.v_user_metrics\n",
        "GROUP BY user_id\n",
        "ORDER BY ca_total DESC\n",
        "LIMIT 10;\n"
      ]
    },
    {
      "name": "4585e67a",
      "displayName": "Retail Transactions Data Overview",
      "queryLines": [
        "\n",
        "SELECT \n",
        "annee_mois,\n",
        "SUM(chiffre_affaires) AS total_ca\n",
        "FROM shoppulse.dev.v_user_metrics\n",
        "GROUP BY annee_mois\n",
        "ORDER BY annee_mois \n"
      ]
    },
    {
      "name": "0ab60ea5",
      "displayName": "shoppulse transaction insights dataset",
      "queryLines": [
        "\n",
        "SELECT annee_mois,sum(nb_commandes) AS nb_commandes\n",
        "FROM shoppulse.dev.v_user_metrics\n",
        "group by annee_mois\n",
        "ORDER BY annee_mois ASC"
      ]
    }
  ],
